# Generated by XcodeGen — regenerate with `xcodegen` from project.yml.
EdgeCat.xcodeproj/

# Xcode build / user state
build/
DerivedData/
*.xcuserdata/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# Vendored LiteRT-LM artifacts produced by scripts/fetch-litertlm.sh
# (built from source via Bazel for iOS arm64). Heavy binaries (dylibs,
# static archives) stay local-only — but the public C API header is text
# and small enough to track so CI can compile the bridge .mm without
# running an 8-minute Bazel build.
LiteRtLmBridge/Vendor/litert_lm/*
!LiteRtLmBridge/Vendor/litert_lm/c/
LiteRtLmBridge/Vendor/litert_lm/c/*
!LiteRtLmBridge/Vendor/litert_lm/c/engine.h
LiteRtLmBridge/Vendor/ios/
LiteRtLmBridge/Vendor/sim/

# Sideloaded models for local testing
**/*.litertlm
models/

# Future multi-agent research dumps stay local. The current decision-record
# file (CODEX_SOLUTION.md) is committed deliberately for context.
research/SCRATCH_*.md

# macOS
.DS_Store
build-device/
test/eval/.venv/
test/eval/runs/
test/eval/scorers/__pycache__/
test/eval/scorers/.pytest_cache/
