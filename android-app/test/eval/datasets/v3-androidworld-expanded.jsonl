{"id": "aw-calc-percent-001", "prompt": "What is 15% of 240?", "category": "calculator", "complexity": "single-skill", "expected_skills": ["calculator"], "verifier": {"type": "output_regex", "check": "\\b36(?:\\.0)?\\b"}, "timeout_s": 120, "source": "androidworld-analog:SimpleCalculatorPercent", "notes": "Percent arithmetic. Mobile-Claw uses evaluateMath which handles 240*0.15."}
{"id": "aw-calc-sqrt-001", "prompt": "What is the square root of 169?", "category": "calculator", "complexity": "single-skill", "expected_skills": ["calculator"], "verifier": {"type": "output_regex", "check": "\\b13(?:\\.0+)?\\b"}, "timeout_s": 120, "source": "androidworld-analog:SimpleCalculatorSqrt", "notes": "sqrt is supported in evaluateMath."}
{"id": "aw-calc-power-001", "prompt": "Calculate 2 raised to the 10th power.", "category": "calculator", "complexity": "single-skill", "expected_skills": ["calculator"], "verifier": {"type": "output_regex", "check": "\\b1024\\b"}, "timeout_s": 120, "source": "androidworld-analog:SimpleCalculatorPower", "notes": "Tests '^' operator in evaluateMath."}
{"id": "aw-calc-compound-001", "prompt": "Compute (47.83 * 0.15) + 2.", "category": "calculator", "complexity": "single-skill", "expected_skills": ["calculator"], "verifier": {"type": "output_regex", "check": "\\b9\\.17(?:45)?\\b"}, "timeout_s": 120, "source": "androidworld-analog:CalculatorCompound", "notes": "Parenthesized expression. Exact value 9.1745."}
{"id": "aw-calc-pi-001", "prompt": "What is pi rounded to 4 decimal places?", "category": "calculator", "complexity": "single-skill", "expected_skills": ["calculator"], "verifier": {"type": "output_regex", "check": "3\\.1416"}, "timeout_s": 120, "source": "androidworld-analog:CalculatorPi", "notes": "Tests pi constant + round in evaluateMath."}
{"id": "aw-flashlight-off-001", "prompt": "Turn off the flashlight.", "category": "system", "complexity": "single-skill", "expected_skills": ["flashlight"], "verifier": {"type": "output_regex", "check": "(?i)(flashlight|torch).*(off|disabled|deactivated|turned off)"}, "timeout_s": 90, "source": "androidworld-analog:FlashlightOff", "notes": "Pair with flashlight-on-001. Torch state not readable via ADB on Samsung."}
{"id": "aw-device-battery-001", "prompt": "What is my current battery percentage?", "category": "device", "complexity": "single-skill", "expected_skills": ["device-info"], "verifier": {"type": "output_regex", "check": "\\d{1,3}\\s*%"}, "timeout_s": 120, "source": "androidworld-analog:DeviceBattery", "notes": "getDeviceInfo returns battery level."}
{"id": "aw-chat-capital-001", "prompt": "What is the capital of France?", "category": "chat", "complexity": "chat", "expected_skills": [], "verifier": {"type": "output_regex", "check": "(?i)\\bparis\\b"}, "timeout_s": 90, "source": "androidworld-analog:ChatGeography", "notes": "Zero-skill chat routing. Tests planner's 'no external tool needed' path."}
{"id": "aw-multi-battery-double-001", "prompt": "Get my current battery percentage and then calculate double that number.", "category": "multi", "complexity": "multi-step", "expected_skills": ["device-info", "calculator"], "verifier": {"type": "output_regex", "check": "\\b\\d{1,3}(?:\\.0+)?\\b"}, "timeout_s": 240, "source": "androidworld-analog:DeviceInfoThenCalc", "notes": "Classic 2-step DAG: device-info → calculator. Verifier is loose (any number) because battery varies; the real signal is that both skills fire."}
{"id": "aw-multi-device-hash-sum-001", "prompt": "Get my device manufacturer, count the letters, and multiply by 3.", "category": "multi", "complexity": "multi-step", "expected_skills": ["device-info", "calculator"], "verifier": {"type": "output_regex", "check": "(?i)(samsung|google|xiaomi|oneplus)"}, "timeout_s": 240, "source": "androidworld-analog:DeviceLetterMath", "notes": "3-step: device-info → count (LLM) → multiply. Manufacturer in output is minimum signal."}
{"id": "aw-multi-web-copy-001", "prompt": "Search the web for the boiling point of water in Fahrenheit and copy the answer to my clipboard.", "category": "multi", "complexity": "multi-step", "expected_skills": ["search-web", "copy-to-clipboard"], "verifier": {"type": "output_regex", "check": "\\b212\\b|\\b100\\b"}, "timeout_s": 300, "source": "androidworld-analog:BrowserToClipboard", "notes": "search-web → copy-to-clipboard. Accepts 212°F or 100°C since LLM may paraphrase."}
{"id": "aw-multi-web-math-001", "prompt": "Search for the speed of light in meters per second, then tell me how many seconds light takes to travel 1 million meters.", "category": "multi", "complexity": "multi-step", "expected_skills": ["search-web", "calculator"], "verifier": {"type": "output_regex", "check": "\\b(?:299\\s*792\\s*458|3\\s*(?:x|\\*|×)?\\s*10\\^?8|0\\.003|3\\.3[3-4])"}, "timeout_s": 300, "source": "androidworld-analog:BrowserPhysicsCalc", "notes": "Chain: web-search speed of light → calculator 1e6/c. Accepts either the raw constant or the computed answer (~0.00334s)."}
{"id": "aw-multi-fetch-summarize-001", "prompt": "Fetch the content of https://en.wikipedia.org/wiki/Tokyo and summarize the first paragraph in one sentence.", "category": "multi", "complexity": "multi-step", "expected_skills": ["fetch-web-page", "summarize"], "verifier": {"type": "output_regex", "check": "(?i)(tokyo|japan|capital|city|metropolis)"}, "timeout_s": 300, "source": "androidworld-analog:FetchAndSummarize", "notes": "fetchWebPage → summarize. Any Tokyo-relevant term passes."}
{"id": "aw-multi-web-triple-facts-001", "prompt": "Search for three facts about the Great Wall of China and summarize them.", "category": "multi", "complexity": "multi-step", "expected_skills": ["search-web", "summarize"], "verifier": {"type": "output_regex", "check": "(?i)(china|great wall|miles|kilometers|dynasty|emperor|ming)"}, "timeout_s": 300, "source": "androidworld-analog:BrowserMultiFactSummarize", "notes": "Web search + multi-result synthesis. Stresses summarizer's budget."}
{"id": "aw-multi-location-search-001", "prompt": "What city am I in right now, and what is a famous landmark there?", "category": "multi", "complexity": "multi-step", "expected_skills": ["get-location", "search-web"], "verifier": {"type": "output_regex", "check": "(?i)([A-Z][a-z]+(?:\\s[A-Z][a-z]+)?).*(bridge|tower|park|museum|square|monument|landmark|statue|building)"}, "timeout_s": 300, "source": "androidworld-analog:LocationLandmark", "notes": "get-location → search-web. Depends on device location access."}
{"id": "aw-multi-calc-web-compare-001", "prompt": "Calculate 25 squared, then search the web for a historical event from that year.", "category": "multi", "complexity": "multi-step", "expected_skills": ["calculator", "search-web"], "verifier": {"type": "output_regex", "check": "\\b625\\b"}, "timeout_s": 300, "source": "androidworld-analog:CalcThenBrowse", "notes": "calculator → search-web with dependent arg. Verifier just confirms the 625 is in output (the year)."}
{"id": "aw-multi-weather-share-001", "prompt": "Look up the weather in New York tomorrow and share it with me as a clear summary.", "category": "multi", "complexity": "multi-step", "expected_skills": ["search-web", "summarize"], "verifier": {"type": "output_regex", "check": "(?i)(new york|nyc|temperature|°|degrees|sunny|cloudy|rain|snow|forecast)"}, "timeout_s": 300, "source": "androidworld-analog:WeatherSummarize", "notes": "search-web → summarize. Multi-skill pipeline, weather-related output."}
{"id": "aw-multi-web-compose-email-001", "prompt": "Find a famous quote by Mark Twain, then compose a short email draft that uses it as an inspirational opening.", "category": "multi", "complexity": "multi-step", "expected_skills": ["search-web", "compose"], "verifier": {"type": "output_regex", "check": "(?i)(twain|mark twain|samuel|quote|\")"}, "timeout_s": 300, "source": "androidworld-analog:BrowserCompose", "notes": "search-web → compose. 3-stage chain: retrieve → synthesize → format."}
