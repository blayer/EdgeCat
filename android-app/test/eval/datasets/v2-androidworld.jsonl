{"id": "aw-calendar-add-tomorrow-001", "prompt": "Create a calendar event for tomorrow at 2pm titled 'Dentist appointment' for 30 minutes.", "category": "calendar", "complexity": "single-skill", "expected_skills": ["calendar"], "verifier": {"type": "state", "check": "calendar_event_exists", "params": {"title_contains": "Dentist", "hour": 14, "day_offset": 1}}, "timeout_s": 180, "source": "androidworld:SimpleCalendarAddOneEventTomorrow", "notes": "Relative date 'tomorrow' + explicit time. Verifier hits system CalendarContract (not Simple Calendar Pro)."}
{"id": "aw-calendar-add-relative-day-001", "prompt": "Add an event to my calendar this Friday at 10am called 'Weekly Review', lasting 1 hour.", "category": "calendar", "complexity": "single-skill", "expected_skills": ["calendar"], "verifier": {"type": "state", "check": "calendar_event_exists", "params": {"title_contains": "Weekly Review", "hour": 10}}, "timeout_s": 180, "source": "androidworld:SimpleCalendarAddOneEventRelativeDay", "notes": "'This Friday' requires relative day-of-week resolution. day_offset omitted so verifier only checks title+hour."}
{"id": "aw-calendar-add-two-weeks-001", "prompt": "Schedule a meeting in two weeks from today at 3pm titled 'Quarterly Planning'.", "category": "calendar", "complexity": "single-skill", "expected_skills": ["calendar"], "verifier": {"type": "state", "check": "calendar_event_exists", "params": {"title_contains": "Quarterly", "hour": 15, "day_offset": 14}}, "timeout_s": 180, "source": "androidworld:SimpleCalendarAddOneEventInTwoWeeks", "notes": "Far-future date arithmetic. Stresses planner's date normalization."}
{"id": "aw-timer-5min-001", "prompt": "Create a 5 minute timer. Do not start it.", "category": "timer", "complexity": "single-skill", "expected_skills": ["timer"], "verifier": {"type": "state", "check": "timer_set", "params": {"minutes": 5}}, "timeout_s": 120, "source": "androidworld:ClockTimerEntry", "notes": "Minimal timer spec. Verifier greps dumpsys — imperfect on Samsung One UI clock, may need fallback to output_regex."}
{"id": "aw-timer-compound-001", "prompt": "Set a timer for 1 hour 30 minutes, but don't start it.", "category": "timer", "complexity": "single-skill", "expected_skills": ["timer"], "verifier": {"type": "output_regex", "check": "(?i)(timer|set).*(1\\s*h(?:our)?|90\\s*min)"}, "timeout_s": 120, "source": "androidworld:ClockTimerEntry", "notes": "Compound unit parsing. Uses output_regex because dumpsys timer state is unreliable cross-ROM."}
{"id": "aw-alarm-7am-001", "prompt": "Set an alarm for 7:00 AM.", "category": "timer", "complexity": "single-skill", "expected_skills": ["timer"], "verifier": {"type": "state", "check": "alarm_exists", "params": {"hour": 7, "minute": 0}}, "timeout_s": 120, "source": "androidworld:ClockTimerEntry (alarm variant)", "notes": "Verifies via dumpsys alarm grep for 07:00 — already in state.py."}
{"id": "aw-contact-add-001", "prompt": "Create a new contact for Sarah Chen. Her number is 555-0142.", "category": "contacts", "complexity": "single-skill", "expected_skills": ["read-contacts"], "verifier": {"type": "state", "check": "contact_exists", "params": {"name_contains": "Sarah Chen"}}, "timeout_s": 180, "source": "androidworld:ContactsAddContact", "notes": "read-contacts is a read skill — may need a write-contact skill. Likely fails cleanly, which is useful signal."}
{"id": "aw-sms-send-001", "prompt": "Send a text message to 555-0199 saying: Running 10 minutes late, see you soon.", "category": "sms", "complexity": "single-skill", "expected_skills": ["send-sms"], "verifier": {"type": "state", "check": "sms_sent", "params": {"number": "5550199", "body_contains": "running"}}, "timeout_s": 180, "source": "androidworld:SimpleSmsSend", "notes": "Requires READ_SMS permission on the eval device. If permission denied, verifier returns false — that's still useful signal."}
{"id": "aw-sms-send-short-001", "prompt": "Text 555-0133 the message: On my way.", "category": "sms", "complexity": "single-skill", "expected_skills": ["send-sms"], "verifier": {"type": "state", "check": "sms_sent", "params": {"number": "5550133", "body_contains": "on my way"}}, "timeout_s": 180, "source": "androidworld:SimpleSmsSend", "notes": "Minimal payload — tests planner's handling of punctuation in body."}
{"id": "aw-system-wifi-off-001", "prompt": "Turn wifi off.", "category": "system", "complexity": "single-skill", "expected_skills": ["open-settings"], "verifier": {"type": "state", "check": "setting_equals", "params": {"namespace": "global", "key": "wifi_on", "expected": "0"}}, "setup": ["svc wifi enable"], "timeout_s": 120, "source": "androidworld:SystemWifiTurnOff", "notes": "Setup ensures wifi starts on. Verifies via settings get global wifi_on. Samsung may expose separate radios — state verifier is authoritative."}
{"id": "aw-system-wifi-on-001", "prompt": "Turn wifi on.", "category": "system", "complexity": "single-skill", "expected_skills": ["open-settings"], "verifier": {"type": "state", "check": "setting_equals", "params": {"namespace": "global", "key": "wifi_on", "expected": ["1", "2"]}}, "setup": ["svc wifi disable"], "timeout_s": 120, "source": "androidworld:SystemWifiTurnOn", "notes": "expected=['1','2'] because airplane+wifi returns 2."}
{"id": "aw-system-brightness-max-001", "prompt": "Set screen brightness to the maximum value.", "category": "system", "complexity": "single-skill", "expected_skills": ["open-settings"], "verifier": {"type": "state", "check": "setting_equals", "params": {"namespace": "system", "key": "screen_brightness", "expected": "255"}}, "setup": ["settings put system screen_brightness 64"], "timeout_s": 120, "source": "androidworld:SystemBrightnessMax", "notes": "Samsung may quantize brightness; if verifier frequently misses, widen expected to a range."}
{"id": "aw-system-brightness-min-001", "prompt": "Set screen brightness to the minimum value.", "category": "system", "complexity": "single-skill", "expected_skills": ["open-settings"], "verifier": {"type": "state", "check": "setting_equals", "params": {"namespace": "system", "key": "screen_brightness", "expected": "1"}}, "setup": ["settings put system screen_brightness 200"], "timeout_s": 120, "source": "androidworld:SystemBrightnessMin", "notes": "Matches SystemBrightnessMin. May need range-based check on OEM ROMs."}
{"id": "aw-system-dnd-on-001", "prompt": "Turn on Do Not Disturb mode.", "category": "system", "complexity": "single-skill", "expected_skills": ["do-not-disturb"], "verifier": {"type": "state", "check": "setting_equals", "params": {"namespace": "global", "key": "zen_mode", "expected": ["1", "2", "3"]}}, "setup": ["cmd notification set_dnd off"], "timeout_s": 120, "source": "androidworld:SystemDoNotDisturb (pattern)", "notes": "zen_mode: 0=off, 1/2/3=various DND levels. Any non-zero counts as 'on'."}
{"id": "aw-flashlight-on-001", "prompt": "Turn on the flashlight.", "category": "system", "complexity": "single-skill", "expected_skills": ["flashlight"], "verifier": {"type": "output_regex", "check": "(?i)(flashlight|torch).*(on|enabled|activated)"}, "timeout_s": 90, "source": "androidworld-analog", "notes": "No reliable ADB verifier for torch state on Samsung. Fall back to agent confirmation string."}
