<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.edgecat.app"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk
        android:minSdkVersion="31"
        android:compileSdkVersion ="35"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Device skills: SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Device skills: Calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Device skills: Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Device skills: Photos -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Device skills: Phone -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Device skills: Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Device skills: Alarm/Timer (implicit via intent, but declare for clarity) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Device skills: List/launch apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="${applicationName}"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="EdgeCat"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EdgeCat"
        tools:targetApi="31">

        <activity
            android:name="com.edgecat.app.EdgeCatActivity"
            android:exported="true"
            android:theme="@style/Theme.EdgeCat"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="uiMode"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hidden, UI-free eval entry point. No MAIN/LAUNCHER filter so it never appears
             in the app drawer. Triggered via adb with a custom action + prompt extras; see
             android-app/test/eval/run.py. Kept in all build types intentionally — the eval harness is
             used during development and QA on production-config devices. -->
        <activity
            android:name="com.edgecat.app.eval.EvalActivity"
            android:exported="true"
            android:theme="@style/Theme.EdgeCat"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:noHistory="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="com.edgecat.app.EVAL_RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Hidden entry point for sideloading a pre-staged model into the canonical download
             layout under the app UID. Avoids the `shell`-owned sideload trap that breaks
             subsequent downloads under Samsung's FUSE scoped storage. See
             com.edgecat.app.ingest.ModelIngestActivity kdoc for usage. -->
        <activity
            android:name="com.edgecat.app.ingest.ModelIngestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.edgecat.app.MODEL_INGEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge">
        </service>

        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
    </application>

</manifest>
